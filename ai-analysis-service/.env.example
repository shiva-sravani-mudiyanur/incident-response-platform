# Local examples only. Spring Boot does not load .env automatically.
# Set these in the PowerShell/IDE environment that starts ai-analysis-service.
# Never commit .env or a real API key. No credential or model is defaulted here.
OPENAI_API_KEY=
# Choose a Chat Completions model available to your account that supports tools.
OPENAI_MODEL=
DIAGNOSTICS_MCP_BASE_URL=http://127.0.0.1:8084
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8085
OPENAI_REQUEST_TIMEOUT=60s
OPENAI_MAX_COMPLETION_TOKENS=2048
ANALYSIS_MCP_CONNECT_TIMEOUT=3s
ANALYSIS_MCP_REQUEST_TIMEOUT=15s
ANALYSIS_MAX_MODEL_ROUNDS=3
ANALYSIS_MAX_TOOL_CALLS=8
ANALYSIS_MAX_EVIDENCE_CHARACTERS=64000
ANALYSIS_MAX_MODEL_RESPONSE_CHARACTERS=16000
# Required only for the opt-in manual-openai Maven integration profile.
MANUAL_ANALYSIS_INCIDENT_ID=

# Stage 12: scoped read-only MCP resilience; optional nonsecret defaults.
# Set these in this application's PowerShell/IDE environment before startup.
# Two total attempts means one retry, only for typed transient I/O/timeouts.
# No retry of MCP tool-error envelopes or initialization/session creation.
# Deadline includes attempts + backoff per operation, NOT the whole analysis.
# Model timeout/budgets are unchanged; no provider retry or paid retry is enabled.
ANALYSIS_RESILIENCE_OPERATION_TIMEOUT=20s
ANALYSIS_RESILIENCE_MAX_ATTEMPTS=2
ANALYSIS_RESILIENCE_RETRY_DELAY=100ms
ANALYSIS_RESILIENCE_SLIDING_WINDOW_SIZE=10
ANALYSIS_RESILIENCE_MINIMUM_NUMBER_OF_CALLS=5
ANALYSIS_RESILIENCE_FAILURE_RATE_THRESHOLD=50
ANALYSIS_RESILIENCE_WAIT_DURATION_IN_OPEN_STATE=10s
ANALYSIS_RESILIENCE_PERMITTED_CALLS_IN_HALF_OPEN_STATE=1
ANALYSIS_RESILIENCE_MAX_CONCURRENT_CALLS=4
