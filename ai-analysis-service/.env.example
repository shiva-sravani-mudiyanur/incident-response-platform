# Local examples only. Spring Boot does not load .env automatically.
# Set these in the PowerShell/IDE environment that starts ai-analysis-service.
# Never commit .env or a real API key. No credential or model is defaulted here.
OPENAI_API_KEY=
# Choose a Chat Completions model available to your account that supports tools.
OPENAI_MODEL=
DIAGNOSTICS_MCP_BASE_URL=http://127.0.0.1:8084
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8085
OPENAI_REQUEST_TIMEOUT=60s
OPENAI_MAX_COMPLETION_TOKENS=2048
ANALYSIS_MCP_CONNECT_TIMEOUT=3s
ANALYSIS_MCP_REQUEST_TIMEOUT=15s
ANALYSIS_MAX_MODEL_ROUNDS=3
ANALYSIS_MAX_TOOL_CALLS=8
ANALYSIS_MAX_EVIDENCE_CHARACTERS=64000
ANALYSIS_MAX_MODEL_RESPONSE_CHARACTERS=16000
# Required only for the opt-in manual-openai Maven integration profile.
MANUAL_ANALYSIS_INCIDENT_ID=
