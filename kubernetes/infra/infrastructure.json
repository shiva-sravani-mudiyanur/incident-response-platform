{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "postgres",
        "labels": {
          "app.kubernetes.io/name": "postgres",
          "app.kubernetes.io/part-of": "incident-response"
        }
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "postgres"
        },
        "ports": [
          {
            "name": "postgres",
            "port": 5432,
            "targetPort": 5432
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "redis",
        "labels": {
          "app.kubernetes.io/name": "redis",
          "app.kubernetes.io/part-of": "incident-response"
        }
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "redis"
        },
        "ports": [
          {
            "name": "redis",
            "port": 6379,
            "targetPort": 6379
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "kafka",
        "labels": {
          "app.kubernetes.io/name": "kafka",
          "app.kubernetes.io/part-of": "incident-response"
        }
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "kafka"
        },
        "ports": [
          {
            "name": "internal",
            "port": 19092,
            "targetPort": 19092
          },
          {
            "name": "controller",
            "port": 9093,
            "targetPort": 9093
          }
        ],
        "clusterIP": "None",
        "publishNotReadyAddresses": true
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "postgres",
        "labels": {
          "app.kubernetes.io/name": "postgres",
          "app.kubernetes.io/part-of": "incident-response"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "postgres"
          }
        },
        "template": {
          "metadata": {
            "name": "postgres",
            "labels": {
              "app.kubernetes.io/name": "postgres",
              "app.kubernetes.io/part-of": "incident-response"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 30,
            "securityContext": {
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "postgres",
                "image": "postgres:17-alpine",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 5432,
                    "name": "postgres"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "NET_RAW"
                    ]
                  }
                },
                "env": [
                  {
                    "name": "POSTGRES_DB",
                    "value": "incident_response"
                  },
                  {
                    "name": "PGDATA",
                    "value": "/var/lib/postgresql/data/pgdata"
                  },
                  {
                    "name": "POSTGRES_USER",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "incident-database",
                        "key": "DB_USERNAME"
                      }
                    }
                  },
                  {
                    "name": "POSTGRES_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "incident-database",
                        "key": "DB_PASSWORD"
                      }
                    }
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/postgresql/data"
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "sh",
                      "-ec",
                      "pg_isready -h 127.0.0.1 -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\""
                    ]
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3,
                  "failureThreshold": 6
                },
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "sh",
                      "-ec",
                      "pg_isready -h 127.0.0.1 -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\""
                    ]
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 3,
                  "failureThreshold": 6
                },
                "startupProbe": {
                  "exec": {
                    "command": [
                      "sh",
                      "-ec",
                      "pg_isready -h 127.0.0.1 -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\""
                    ]
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3,
                  "failureThreshold": 60
                }
              }
            ]
          }
        },
        "serviceName": "postgres",
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "1Gi"
                }
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "redis",
        "labels": {
          "app.kubernetes.io/name": "redis",
          "app.kubernetes.io/part-of": "incident-response"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "redis"
          }
        },
        "template": {
          "metadata": {
            "name": "redis",
            "labels": {
              "app.kubernetes.io/name": "redis",
              "app.kubernetes.io/part-of": "incident-response"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 30,
            "securityContext": {
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "redis",
                "image": "redis:8.2-alpine",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 6379,
                    "name": "redis"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "NET_RAW"
                    ]
                  }
                },
                "args": [
                  "--save",
                  "",
                  "--appendonly",
                  "no"
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "redis-cli",
                      "ping"
                    ]
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3
                },
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "redis-cli",
                      "ping"
                    ]
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 3
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "kafka",
        "labels": {
          "app.kubernetes.io/name": "kafka",
          "app.kubernetes.io/part-of": "incident-response"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "kafka"
          }
        },
        "template": {
          "metadata": {
            "name": "kafka",
            "labels": {
              "app.kubernetes.io/name": "kafka",
              "app.kubernetes.io/part-of": "incident-response"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 30,
            "securityContext": {
              "seccompProfile": {
                "type": "RuntimeDefault"
              },
              "fsGroup": 1000
            },
            "containers": [
              {
                "name": "kafka",
                "image": "apache/kafka:4.1.2",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 19092,
                    "name": "internal"
                  },
                  {
                    "containerPort": 9093,
                    "name": "controller"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "250m",
                    "memory": "512Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "1Gi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "NET_RAW"
                    ]
                  }
                },
                "env": [
                  {
                    "name": "KAFKA_NODE_ID",
                    "value": "1"
                  },
                  {
                    "name": "KAFKA_PROCESS_ROLES",
                    "value": "broker,controller"
                  },
                  {
                    "name": "KAFKA_LISTENERS",
                    "value": "INTERNAL://:19092,CONTROLLER://:9093"
                  },
                  {
                    "name": "KAFKA_ADVERTISED_LISTENERS",
                    "value": "INTERNAL://kafka:19092"
                  },
                  {
                    "name": "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP",
                    "value": "INTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT"
                  },
                  {
                    "name": "KAFKA_INTER_BROKER_LISTENER_NAME",
                    "value": "INTERNAL"
                  },
                  {
                    "name": "KAFKA_CONTROLLER_LISTENER_NAMES",
                    "value": "CONTROLLER"
                  },
                  {
                    "name": "KAFKA_CONTROLLER_QUORUM_VOTERS",
                    "value": "1@kafka-0.kafka:9093"
                  },
                  {
                    "name": "CLUSTER_ID",
                    "value": "D6cCDEn1Rm-oKMSpR7LN-A"
                  },
                  {
                    "name": "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR",
                    "value": "1"
                  },
                  {
                    "name": "KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR",
                    "value": "1"
                  },
                  {
                    "name": "KAFKA_TRANSACTION_STATE_LOG_MIN_ISR",
                    "value": "1"
                  },
                  {
                    "name": "KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS",
                    "value": "0"
                  },
                  {
                    "name": "KAFKA_AUTO_CREATE_TOPICS_ENABLE",
                    "value": "false"
                  },
                  {
                    "name": "KAFKA_LOG_DIRS",
                    "value": "/var/lib/kafka/data"
                  },
                  {
                    "name": "KAFKA_HEAP_OPTS",
                    "value": "-Xms256m -Xmx512m"
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/kafka/data"
                  }
                ],
                "startupProbe": {
                  "tcpSocket": {
                    "port": 19092
                  },
                  "timeoutSeconds": 3,
                  "periodSeconds": 10,
                  "failureThreshold": 60
                },
                "livenessProbe": {
                  "tcpSocket": {
                    "port": 19092
                  },
                  "timeoutSeconds": 3,
                  "periodSeconds": 10,
                  "failureThreshold": 6
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "/opt/kafka/bin/kafka-topics.sh",
                      "--bootstrap-server",
                      "127.0.0.1:19092",
                      "--list"
                    ]
                  },
                  "timeoutSeconds": 15,
                  "periodSeconds": 20,
                  "failureThreshold": 6
                }
              }
            ]
          }
        },
        "serviceName": "kafka",
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "1Gi"
                }
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "kafka-init",
        "labels": {
          "app.kubernetes.io/name": "kafka-init",
          "app.kubernetes.io/part-of": "incident-response"
        }
      },
      "spec": {
        "backoffLimit": 6,
        "activeDeadlineSeconds": 300,
        "template": {
          "metadata": {
            "name": "kafka-init",
            "labels": {
              "app.kubernetes.io/name": "kafka-init",
              "app.kubernetes.io/part-of": "incident-response"
            }
          },
          "spec": {
            "restartPolicy": "OnFailure",
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "create-topic",
                "image": "apache/kafka:4.1.2",
                "imagePullPolicy": "IfNotPresent",
                "env": [
                  {
                    "name": "KAFKA_HEAP_OPTS",
                    "value": "-Xms32m -Xmx128m"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "384Mi"
                  }
                },
                "command": [
                  "/bin/sh",
                  "-ec",
                  "/opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka:19092 --create --if-not-exists --topic service-events --partitions 3 --replication-factor 1"
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
