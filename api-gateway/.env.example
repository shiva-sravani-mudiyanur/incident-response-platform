# Gateway-only settings. PowerShell does not automatically load this file.
# Keep existing applications running independently on their original ports.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8081
GATEWAY_EVENT_SERVICE_URL=http://127.0.0.1:8082
GATEWAY_INCIDENT_SERVICE_URL=http://127.0.0.1:8080
GATEWAY_ANALYSIS_SERVICE_URL=http://127.0.0.1:8085
GATEWAY_SIMULATOR_URL=http://127.0.0.1:8083
GATEWAY_CONNECT_TIMEOUT_MS=2000
GATEWAY_RESPONSE_TIMEOUT=5m
# No API key, database, Redis, Kafka, or MCP credentials belong in the gateway.
