# Optional Compose template and application environment reference.
# Copy to .env and set your own password for Compose configuration.
# Never commit .env or a real password. No default password is provided.
# These are local-development examples, not hardcoded application settings.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=incident_response
DB_USERNAME=incident_app
DB_PASSWORD=
# Spring Boot does NOT load .env automatically. Set the same DB_* values in
# PowerShell or your IDE when running incident-service outside Docker.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092
KAFKA_ADVERTISED_HOST=localhost
KAFKA_EVENTS_TOPIC=service-events
KAFKA_CONSUMER_GROUP=incident-processors
# Nonsecret cluster identity; keep it stable while reusing kafka_data.
KAFKA_CLUSTER_ID=D6cCDEn1Rm-oKMSpR7LN-A
KAFKA_PUBLISH_TIMEOUT=5s
KAFKA_RETRY_INTERVAL=1s
REDIS_HOST=localhost
REDIS_PORT=6379
INCIDENT_CORRELATION_THRESHOLD=5
INCIDENT_CORRELATION_WINDOW_SECONDS=60

# Stage 8: incident-service operational health thresholds (independent of correlation).
# Positive values required; DOWN threshold must be greater than DEGRADED threshold.
# errorsLastMinute always uses a separate fixed 60-second Redis health window.
INCIDENT_HEALTH_DEGRADED_THRESHOLD=2
INCIDENT_HEALTH_DOWN_THRESHOLD=5

# Stage 7: service-simulator (Windows-native Java process, not a Compose service).
# Compose .env does NOT populate Java process environment variables.
# Set these explicitly with $env:NAME = 'value' in the simulator PowerShell
# terminal or IDE. No Kafka, Redis, or database variables are needed there.
# Required application setting; the URL below is a local-development example.
EVENT_SERVICE_BASE_URL=http://localhost:8082
# Simulator port defaults to 8083. Set $env:SERVER_PORT = '8083' in its terminal;
# do not share a global SERVER_PORT between the three applications.
# Optional simulator defaults; failure count is independent of incident threshold.
# Failure count must be 1..100; a zero cascade delay is allowed.
SIMULATOR_FAILURE_EVENT_COUNT=5
SIMULATOR_CASCADE_DELAY=250ms
SIMULATOR_CONNECT_TIMEOUT=2s
SIMULATOR_READ_TIMEOUT=15s
