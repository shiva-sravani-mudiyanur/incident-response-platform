# Optional Compose template and application environment reference.
# Copy to .env and set your own password for Compose configuration.
# Never commit .env or a real password. No default password is provided.
# These are local-development examples, not hardcoded application settings.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=incident_response
DB_USERNAME=incident_app
DB_PASSWORD=
# Spring Boot does NOT load .env automatically. Set the same DB_* values in
# PowerShell or your IDE when running incident-service outside Docker.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092
KAFKA_ADVERTISED_HOST=localhost
KAFKA_EVENTS_TOPIC=service-events
KAFKA_CONSUMER_GROUP=incident-processors
# Nonsecret cluster identity; keep it stable while reusing kafka_data.
KAFKA_CLUSTER_ID=D6cCDEn1Rm-oKMSpR7LN-A
KAFKA_PUBLISH_TIMEOUT=5s
KAFKA_RETRY_INTERVAL=1s
REDIS_HOST=localhost
REDIS_PORT=6379
INCIDENT_CORRELATION_THRESHOLD=5
INCIDENT_CORRELATION_WINDOW_SECONDS=60

# Stage 8: incident-service operational health thresholds (independent of correlation).
# Positive values required; DOWN threshold must be greater than DEGRADED threshold.
# errorsLastMinute always uses a separate fixed 60-second Redis health window.
INCIDENT_HEALTH_DEGRADED_THRESHOLD=2
INCIDENT_HEALTH_DOWN_THRESHOLD=5

# Stage 7: service-simulator (Windows-native Java process, not a Compose service).
# Compose .env does NOT populate Java process environment variables.
# Set these explicitly with $env:NAME = 'value' in the simulator PowerShell
# terminal or IDE. No Kafka, Redis, or database variables are needed there.
# Required application setting; the URL below is a local-development example.
EVENT_SERVICE_BASE_URL=http://localhost:8082
# Simulator port defaults to 8083. Set $env:SERVER_PORT = '8083' in its terminal;
# do not share a global SERVER_PORT between the three applications.
# Optional simulator defaults; failure count is independent of incident threshold.
# Failure count must be 1..100; a zero cascade delay is allowed.
SIMULATOR_FAILURE_EVENT_COUNT=5
SIMULATOR_CASCADE_DELAY=250ms
SIMULATOR_CONNECT_TIMEOUT=2s
SIMULATOR_READ_TIMEOUT=15s

# Stage 9: diagnostics-mcp-server. Only incident-service HTTP access is needed.
# Origin URL only: do not append /api/incidents or /api/services.
INCIDENT_SERVICE_BASE_URL=http://localhost:8080
# Defaults: SERVER_PORT=8084, SERVER_ADDRESS=127.0.0.1 in the MCP terminal only.
DIAGNOSTICS_CONNECT_TIMEOUT=2s
DIAGNOSTICS_READ_TIMEOUT=5s
DIAGNOSTICS_HISTORY_PAGE_SIZE=100
DIAGNOSTICS_MAX_HISTORY_PAGES=5
DIAGNOSTICS_RECENT_ERROR_WINDOW=60s
DIAGNOSTICS_RELATED_LOOKBACK=60s
DIAGNOSTICS_RELATED_LOOKAHEAD=60s
DIAGNOSTICS_MCP_REQUEST_TIMEOUT=2m

# Stage 10: ai-analysis-service (native process; use its own PowerShell terminal).
# Never place a real key in this example. Model selection is explicit, not defaulted.
OPENAI_API_KEY=
OPENAI_MODEL=
DIAGNOSTICS_MCP_BASE_URL=http://127.0.0.1:8084
OPENAI_REQUEST_TIMEOUT=60s
OPENAI_MAX_COMPLETION_TOKENS=2048
ANALYSIS_MCP_CONNECT_TIMEOUT=3s
ANALYSIS_MCP_REQUEST_TIMEOUT=15s
ANALYSIS_MAX_MODEL_ROUNDS=3
ANALYSIS_MAX_TOOL_CALLS=8
ANALYSIS_MAX_EVIDENCE_CHARACTERS=64000
ANALYSIS_MAX_MODEL_RESPONSE_CHARACTERS=16000
# Set SERVER_PORT=8085 and SERVER_ADDRESS=127.0.0.1 in the AI terminal only.
# Optional manual integration profile only; use an actual incident UUID.
MANUAL_ANALYSIS_INCIDENT_ID=

# Stage 11: api-gateway (native process; use its own PowerShell terminal).
# Required destination URLs; these are nonsecret local-development examples.
# Spring Boot does NOT load .env automatically; set these in the gateway terminal.
GATEWAY_EVENT_SERVICE_URL=http://127.0.0.1:8082
GATEWAY_INCIDENT_SERVICE_URL=http://127.0.0.1:8080
GATEWAY_ANALYSIS_SERVICE_URL=http://127.0.0.1:8085
GATEWAY_SIMULATOR_URL=http://127.0.0.1:8083
# Optional gateway defaults: connection timeout in milliseconds; response duration.
GATEWAY_CONNECT_TIMEOUT_MS=2000
GATEWAY_RESPONSE_TIMEOUT=5m
# Set SERVER_PORT=8081 and SERVER_ADDRESS=127.0.0.1 in the gateway terminal only.
# Do not share a global SERVER_PORT with the other independently running services.
# No database/Kafka/Redis credentials, MCP URL, or model/API key is needed here.

# Stage 12: diagnostics REST GET resilience (diagnostics process only).
# Optional nonsecret defaults. Two total attempts means one retry.
# Deadline includes attempts + backoff for ONE GET, not a whole history scan.
# Spring Boot does NOT load .env automatically; set in the launching terminal/IDE.
DIAGNOSTICS_RESILIENCE_OPERATION_TIMEOUT=8s
DIAGNOSTICS_RESILIENCE_MAX_ATTEMPTS=2
DIAGNOSTICS_RESILIENCE_RETRY_DELAY=100ms
DIAGNOSTICS_RESILIENCE_SLIDING_WINDOW_SIZE=10
DIAGNOSTICS_RESILIENCE_MINIMUM_NUMBER_OF_CALLS=5
DIAGNOSTICS_RESILIENCE_FAILURE_RATE_THRESHOLD=50
DIAGNOSTICS_RESILIENCE_WAIT_DURATION_IN_OPEN_STATE=10s
DIAGNOSTICS_RESILIENCE_PERMITTED_CALLS_IN_HALF_OPEN_STATE=1
DIAGNOSTICS_RESILIENCE_MAX_CONCURRENT_CALLS=4

# Stage 12: scoped MCP diagnostic-read resilience (AI process only).
# Not a global analysis/model deadline; no provider or gateway retry is enabled.
# Initialization/discovery is bounded but has no application retry.
ANALYSIS_RESILIENCE_OPERATION_TIMEOUT=20s
ANALYSIS_RESILIENCE_MAX_ATTEMPTS=2
ANALYSIS_RESILIENCE_RETRY_DELAY=100ms
ANALYSIS_RESILIENCE_SLIDING_WINDOW_SIZE=10
ANALYSIS_RESILIENCE_MINIMUM_NUMBER_OF_CALLS=5
ANALYSIS_RESILIENCE_FAILURE_RATE_THRESHOLD=50
ANALYSIS_RESILIENCE_WAIT_DURATION_IN_OPEN_STATE=10s
ANALYSIS_RESILIENCE_PERMITTED_CALLS_IN_HALF_OPEN_STATE=1
ANALYSIS_RESILIENCE_MAX_CONCURRENT_CALLS=4
